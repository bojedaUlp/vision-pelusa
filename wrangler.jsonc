{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "vision-pelusa",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "vision-pelusa"
    }
  ],
   "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "images": {
    "binding": "IMAGES"
  },
  // Photo storage. ORIGINALS: private (no public access, no custom domain), read only by this
  // Worker after validating a purchase. MEDIA: watermarked previews/thumbnails/heroes, public.
  "r2_buckets": [
    {
      "binding": "ORIGINALS_BUCKET",
      "bucket_name": "vision-pelusa-originals"
    },
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "vision-pelusa-media"
    }
  ],
  "vars": {
    // Operational storage budget in bytes (8 GB, below R2's free 10 GB-month).
    "STORAGE_BUDGET_BYTES": "8000000000",
    // Mercado Pago preferences (and cash tickets) expire 72 h after checkout. Approved 2026-11-15.
    "MP_PREFERENCE_EXPIRATION_HOURS": "72"
  }
}
